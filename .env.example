# Copie para .env.local e ajuste o caminho do Blender 5.2 LTS.
# Windows: C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
# macOS:   /Applications/Blender.app/Contents/MacOS/Blender
# Linux:   blender (se estiver no PATH) ou o caminho completo
BLENDER_BIN=blender

# Fase 7 (nuvem): as chaves do projeto Supabase (Project Settings → API). Sem elas, os livros ficam só
# neste navegador. Passo a passo em docs/deploy/passo-a-passo.md.
# VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...
