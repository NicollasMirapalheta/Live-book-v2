{
  "name": "live-book",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "tsc -b && oxlint && vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "shot": "node --env-file-if-exists=.env.local --import tsx scripts/shot.ts",
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "assets:contact": "node --env-file-if-exists=.env.local --import tsx scripts/contact-sheet.ts",
    "blender:check": "node --env-file-if-exists=.env.local scripts/blender.mjs check",
    "blender:build": "node --env-file-if-exists=.env.local scripts/blender.mjs build",
    "blender:preview": "node --env-file-if-exists=.env.local scripts/blender.mjs preview",
    "blender:bake": "node --env-file-if-exists=.env.local scripts/blender.mjs bake",
    "blender:denoise": "node --env-file-if-exists=.env.local scripts/blender.mjs denoise",
    "blender:export": "node --env-file-if-exists=.env.local scripts/blender.mjs export",
    "optimize": "node --env-file-if-exists=.env.local --import tsx scripts/optimize.ts",
    "pipeline": "node --env-file-if-exists=.env.local --import tsx scripts/pipeline.ts",
    "blender:assets": "node --env-file-if-exists=.env.local scripts/blender.mjs assets",
    "textures": "node --import tsx scripts/prepare-textures.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "detect-gpu": "^5.0.70",
    "gsap": "^3.15.0",
    "postprocessing": "^6.39.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "leva": "^0.10.1",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22.12"
  }
}
